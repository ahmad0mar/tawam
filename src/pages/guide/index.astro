---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import InquiryCtaBand from '~/components/widgets/InquiryCtaBand.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const metadata = {
  title: 'College Admission & Counselling Guides — Tawam Travels',
  description:
    'Comprehensive admission roadmaps, NEET & JEE counselling processes, document verification checklists, and choice filling strategies.',
};

const guideCategories = [
  {
    title: 'Medical Admissions & NEET Counselling',
    badge: 'Medical',
    description:
      'Step-by-step guidance on MCC 15% All India Quota, 85% State Quota counselling, bond conditions, and Deemed University seat matrix.',
    keyPoints: [
      'Understanding AIQ vs State Quota reservation rules',
      'Deemed University fee structures (Category A, Management & NRI)',
      'Service bond policies and bank guarantee requirements',
      'Upgradation rules between Round 1, Round 2, and Mop-up rounds',
    ],
    articleUrl: getPermalink('neet-ug-counselling-explained', 'post'),
    articleText: 'Read Full NEET Guide',
  },
  {
    title: 'Engineering Admissions (JoSAA & State CETs)',
    badge: 'Engineering',
    description:
      'Roadmap for navigating JoSAA, CSAB special rounds, and state-level engineering counselling like KCET, COMEDK, and TNEA.',
    keyPoints: [
      'Government (IITs/NITs) vs Top Private University comparison',
      'Choice locking strategy for CS/IT specializations',
      'Dual seat acceptance fee guidelines in CSAB rounds',
      'Campus placement and ROI analysis across tier-1 & tier-2 institutes',
    ],
    articleUrl: getPermalink('government-vs-private-engineering-colleges', 'post'),
    articleText: 'Read Engineering Guide',
  },
  {
    title: 'Scholarships & Tuition Fee Waivers',
    badge: 'Financial Aid',
    description:
      'Complete overview of NSP central schemes, state post-matric reimbursements, AICTE Pragati, and institutional merit waivers.',
    keyPoints: [
      'Income certificate validity and issuing authority guidelines',
      'Aadhaar-seeded bank account setup for Direct Benefit Transfer',
      'Renewal criteria: minimum CGPA/percentage requirements',
      'Combining institutional concessions with government schemes',
    ],
    articleUrl: getPermalink('scholarships-for-indian-students', 'post'),
    articleText: 'Read Scholarship Guide',
  },
];

const documentChecklist = [
  {
    category: 'Academic Proofs',
    items: [
      'Class 10 (SSLC) Board Certificate / Marksheet (Proof of Date of Birth)',
      'Class 12 (HSC / PUC / CBSE / ISC) Statement of Marks and Passing Certificate',
      'Transfer Certificate (TC) from the last attended school or college',
      'Migration Certificate (mandatory for students changing state boards or universities)',
    ],
  },
  {
    category: 'Entrance & Allotment Credentials',
    items: [
      'Official Entrance Exam Admit Card (NEET-UG, JEE Main, KCET, VITEEE, etc.)',
      'Official Entrance Exam Scorecard / Rank Letter with All India Rank',
      'Provisional Seat Allotment Order issued by the Counselling Authority (MCC / JoSAA / KEA)',
      'Counselling Fee Payment Receipt and Document Verification Slip',
    ],
  },
  {
    category: 'Identity & Category Documentation',
    items: [
      'Government Photo Identity (Original Aadhaar Card / Passport)',
      '6–8 Recent Passport-Size Photographs (identical to the entrance exam admit card)',
      'Category Certificate (OBC-NCL, SC, ST, EWS) in Government format issued in current financial year',
      'Domicile / Nativity Certificate (mandatory for state quota claims)',
    ],
  },
  {
    category: 'Statutory Undertakings & Health',
    items: [
      'Physical Fitness Certificate issued by an authorized Registered Medical Practitioner',
      'Anti-Ragging Affidavits signed by student and parent (UGC portal format)',
      'Study Gap Certificate / Affidavit (if there was a 1+ year study gap after Class 12)',
    ],
  },
];
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow="Step-by-Step Roadmaps"
    title="Admission & Counselling Guides"
    subtitle="Clear, verified guides covering centralized counselling, choice filling strategies, eligibility rules, and document verification across India."
    image="~/assets/images/random/passport-window.jpeg"
    imageAlt="Indian passport and boarding pass at aircraft window representing educational admission journeys"
  />
  <Breadcrumbs bar hideCurrent items={[{ text: 'Home', href: getPermalink('/') }, { text: 'Admission Guides' }]} />

  <section class="px-4 sm:px-6 py-6 sm:py-10 mx-auto max-w-7xl">
    <!-- Key Admission Streams -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-10">
      {
        guideCategories.map((guide) => (
          <div class="bg-white border border-[var(--aw-color-border)] rounded-2xl p-6 sm:p-7 flex flex-col justify-between hover:shadow-md hover:border-[var(--aw-color-accent)] transition">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="inline-block bg-[var(--aw-color-bg-soft)] text-[var(--aw-color-primary)] text-xs font-bold px-2.5 py-1 rounded-full border border-[var(--aw-color-border)]">
                  {guide.badge}
                </span>
                <span class="text-xs font-semibold text-[var(--aw-color-text-muted)]">Verified 2026</span>
              </div>

              <h2 class="text-xl font-serif font-bold text-[var(--aw-color-text-heading)] mb-2">{guide.title}</h2>
              <p class="text-xs sm:text-sm text-[var(--aw-color-text-muted)] leading-relaxed mb-4">
                {guide.description}
              </p>

              <div class="mb-5">
                <div class="text-xs font-bold uppercase tracking-wider text-[var(--aw-color-text-default)] mb-2">
                  What You'll Learn:
                </div>
                <ul class="space-y-1.5 text-xs text-[var(--aw-color-text-muted)]">
                  {guide.keyPoints.map((point) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-[#9A6300] font-bold shrink-0">✓</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-[var(--aw-color-border)]">
              <a
                href={guide.articleUrl}
                class="btn-primary w-full py-2.5 px-4 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 shadow-sm hover:opacity-95 transition"
              >
                <span>{guide.articleText}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Interactive Document Verification Checklist -->
    <div class="mt-14 bg-[var(--aw-color-bg-soft)] rounded-3xl p-6 sm:p-10 border border-[var(--aw-color-border)]">
      <div class="max-w-3xl mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-[#9A6300]">Verification Readiness</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--aw-color-text-heading)] mt-1 mb-2">
          Universal Admission Document Checklist
        </h2>
        <p class="text-xs sm:text-sm text-[var(--aw-color-text-muted)] leading-relaxed">
          Ensure all original documents and at least 4 sets of self-attested photocopies are assembled prior to your
          physical verification date. Missing mandatory proofs can lead to immediate seat forfeiture.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          documentChecklist.map((group) => (
            <div class="bg-white rounded-2xl p-6 border border-[var(--aw-color-border)] shadow-sm">
              <h3 class="text-base font-serif font-bold text-[var(--aw-color-text-heading)] mb-3 pb-2 border-b border-[var(--aw-color-border)] flex items-center justify-between">
                <span>{group.category}</span>
                <span class="text-xs font-mono font-normal text-[var(--aw-color-text-muted)]">
                  {group.items.length} items
                </span>
              </h3>
              <ul class="space-y-2.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs text-[var(--aw-color-text-default)] leading-relaxed">
                    <span class="w-4 h-4 rounded border border-[#9A6300] bg-[var(--aw-color-bg-soft)] text-[#9A6300] flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="mt-8 pt-6 border-t border-[var(--aw-color-border)] flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <div class="text-xs text-[var(--aw-color-text-muted)]">
          <strong>Need document evaluation?</strong> Bring your papers to our counselling team for pre-scrutiny before official
          reporting.
        </div>
        <Button variant="primary" text="Schedule Document Review" href={getPermalink('/contact')} />
      </div>
    </div>
  </section>

  <!-- 4-Stage Counselling Roadmap (Dark Teal-Navy Band) -->
  <Section tone="navy" mandala="left" class="py-14 sm:py-20">
    <SectionHeader
      tone="dark"
      align="center"
      eyebrow="Process Architecture"
      title="How Centralized Counselling Unfolds"
      subtitle="Understanding the 4-phase cycle prevents costly mistakes during seat allotment and locking."
      class="mb-10"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="p-5 sm:p-6 rounded-[18px] bg-white/[0.06] border border-white/12">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[var(--tt-gold)] text-[var(--tt-teal-navy)] mb-3"
        >
          Phase 1
        </span>
        <h3 class="text-base font-heading font-bold text-white mb-2">Registration &amp; Fee</h3>
        <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
          Candidate registers on the counselling portal (MCC / JoSAA / State authority), deposits security fee, and gets
          credentials verified.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-[18px] bg-white/[0.06] border border-white/12">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[var(--tt-gold)] text-[var(--tt-teal-navy)] mb-3"
        >
          Phase 2
        </span>
        <h3 class="text-base font-heading font-bold text-white mb-2">Choice Filling &amp; Locking</h3>
        <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
          Prioritizing college choices in descending order of preference. Locking choices before the server cutoff
          window is strictly required.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-[18px] bg-white/[0.06] border border-white/12">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[var(--tt-gold)] text-[var(--tt-teal-navy)] mb-3"
        >
          Phase 3
        </span>
        <h3 class="text-base font-heading font-bold text-white mb-2">Seat Allotment &amp; Report</h3>
        <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
          Portal publishes provisional allotment based on merit and quota. Candidate downloads letter and reports
          physically for verification.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-[18px] bg-white/[0.06] border border-white/12">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[var(--tt-gold)] text-[var(--tt-teal-navy)] mb-3"
        >
          Phase 4
        </span>
        <h3 class="text-base font-heading font-bold text-white mb-2">Freeze vs Upgradation</h3>
        <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
          Opt to "Freeze" the seat to finalize admission, or opt for "Float / Slide / Upgradation" to compete for higher
          choices in Round 2.
        </p>
      </div>
    </div>
  </Section>

  <InquiryCtaBand />
</Layout>
