---
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About Tawam Travels',
  description:
    'Dedicated education counselling and student guidance service helping students find accredited colleges and navigate admissions with confidence.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="<span class='text-amber-400 font-bold'>About Tawam Travels</span>"
    actions={[
      {
        variant: 'primary',
        text: 'Get Counselling',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 overflow-hidden">
        <Image
          src="~/assets/images/random/taj-mahal-travel.jpeg"
          alt="Student traveller viewing the Taj Mahal at sunset representing educational journeys across India"
          layout="cover"
          class="w-full h-full object-cover object-center"
          width={1920}
          height={600}
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#112542]/95 via-[#1B365D]/88 to-[#28558C]/80"></div>
      </div>
    </Fragment>

    <Fragment slot="title">
      <span class="text-white">Guiding Students Toward Their Academic Future</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-white/85">
        Tawam Travels gives students straightforward, one-on-one counselling for college admissions across India. We
        help you sort through entrance exam rules, course options, and application deadlines.
      </span>
    </Fragment>
  </Hero>

  <Features3
    title="Our Counselling Services"
    subtitle="Admission guidance built around your scores, budget, and career goals."
    columns={3}
    items={[
      {
        title: 'Medical Admissions',
        description:
          'Expert guidance on NEET UG counselling, AIQ, state quotas, deemed universities, and medical college cutoffs.',
        icon: 'tabler:stethoscope',
      },
      {
        title: 'Engineering & Technology',
        description:
          'Comparing JEE Main and state CET cutoffs alongside NIRF data to shortlist engineering colleges that match your branch.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Management & Professional',
        description: 'Admissions guidance for MBA, BBA, Law, and allied health sciences with transparent fee insights.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <Steps2
    title="How We Work With You"
    subtitle="Three clear steps from profile review to final seat allotment."
    bg="<div class='absolute inset-0 bg-[var(--tt-cream-soft)]/70 border-y border-[var(--tt-border-warm)]'></div>"
    items={[
      {
        title: '1. Profile Evaluation & Aspirations',
        description:
          'We evaluate your academic record, entrance exam scores, preferred courses, and financial considerations.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: '2. Shortlisting & Strategy',
        description:
          'We provide a curated shortlist of accredited colleges with historical cutoffs, verified fees, and placement tracks.',
        icon: 'tabler:list-check',
      },
      {
        title: '3. Application & Counselling Assistance',
        description:
          'We assist with document preparation, option entry, choice filling, and seat acceptance guidance throughout all rounds.',
        icon: 'tabler:school',
      },
    ]}
  />

  <CallToAction
    layout="banner"
    title="Ready to Start Your Academic Journey?"
    subtitle="Speak directly with our counsellors and discover the right colleges for your profile."
    actions={[
      {
        variant: 'primary',
        text: 'Contact Our Team',
        href: getPermalink('/contact'),
      },
    ]}
  />
</Layout>
