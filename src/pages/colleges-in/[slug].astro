---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import InquiryCtaBand from '~/components/widgets/InquiryCtaBand.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import CollegeCard from '~/components/colleges/CollegeCard.astro';
import { getPermalink } from '~/utils/permalinks';
import { getAllStates, resolveLocationSlug } from '~/utils/colleges';

export const prerender = true;

export const getStaticPaths = (async () => {
  const states = getAllStates();
  const colleges = await getCollection('colleges');

  // Collect all state slugs
  const paths: Array<{ params: { slug: string } }> = states.map((s) => ({ params: { slug: s.slug } }));

  // Also include cities that have colleges so any city URL resolves cleanly to state
  for (const c of colleges) {
    if (!paths.some((p) => p.params.slug === c.data.city_slug)) {
      paths.push({ params: { slug: c.data.city_slug } });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const loc = resolveLocationSlug(slug || '');

// Determine effective state and optional city focus
const isCitySlug = loc?.type === 'city';
const effectiveState = isCitySlug ? loc.state : loc?.type === 'state' ? loc.state : null;
const stateName = effectiveState?.name || (slug || '').replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const stateSlug = effectiveState?.slug || slug || '';
const focusedCity = isCitySlug ? loc.city : null;

// Fetch colleges for this state
const allColleges = await getCollection('colleges');
const stateColleges = allColleges.filter((c) => {
  if (!effectiveState) return c.data.state_slug === slug || c.data.city_slug === slug;
  if (isCitySlug && focusedCity) {
    return c.data.city_slug === focusedCity.slug;
  }
  return c.data.state_slug === effectiveState.slug;
});

// All colleges in this entire state (for count and city pills)
const allStateColleges = allColleges.filter((c) => c.data.state_slug === stateSlug);
const citiesWithCollegesInState = [
  ...new Set(allStateColleges.map((c) => ({ name: c.data.city, slug: c.data.city_slug }))),
].filter((v, i, a) => a.findIndex((t) => t.slug === v.slug) === i);

// Breadcrumbs construction
const breadcrumbs: Array<{ text: string; href?: string }> = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Colleges', href: getPermalink('/colleges') },
];

if (isCitySlug && focusedCity) {
  breadcrumbs.push({
    text: stateName,
    href: getPermalink(`/colleges-in/${stateSlug}`),
  });
  breadcrumbs.push({ text: focusedCity.name });
} else {
  breadcrumbs.push({ text: stateName });
}

const pageTitle = focusedCity
  ? `Colleges in ${focusedCity.name}, ${stateName}`
  : `Colleges & Universities in ${stateName}`;

const metadata = {
  title: `${pageTitle} | Admissions & Counselling — Tawam Travels`,
  description: `Explore top colleges in ${stateName} including cutoffs, rankings, courses, and admission procedures.`,
};
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={`State Directory · ${stateName}`}
    title={pageTitle}
    subtitle={focusedCity
      ? `Showing institutions located in ${focusedCity.name}. Click 'All ${stateName} Colleges' to view the full state list.`
      : `Explore accredited colleges across ${stateName}. Select an institution to view detailed course fees, rankings, and cutoffs.`}
  />
  <Breadcrumbs bar hideCurrent items={breadcrumbs} />

  <section class="px-4 sm:px-6 py-10 sm:py-14 mx-auto max-w-7xl">
    <!-- State Overview & City Filter Strip -->
    {
      allStateColleges.length > 0 && (
        <div class="mb-10 p-5 rounded-none bg-[var(--aw-color-bg-soft)] border border-[var(--aw-color-border)]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--aw-color-primary)]">
              Cities with Colleges in {stateName}
            </span>
            {focusedCity && (
              <a
                href={getPermalink(`/colleges-in/${stateSlug}`)}
                class="text-xs font-semibold text-[var(--aw-color-link)] hover:underline"
              >
                &larr; View all colleges across {stateName}
              </a>
            )}
          </div>

          <div class="flex flex-wrap gap-2 items-center">
            {/* All Cities in State Pill */}
            <a
              href={getPermalink(`/colleges-in/${stateSlug}`)}
              class={`px-3.5 py-1.5 rounded-none border text-xs transition ${
                !focusedCity
                  ? 'font-bold bg-[var(--aw-color-primary)] border-[var(--aw-color-primary)] text-white shadow-sm'
                  : 'font-medium bg-white text-[var(--aw-color-text-default)] border-[var(--aw-color-border)] hover:border-[var(--aw-color-primary)]'
              }`}
            >
              All {stateName} ({allStateColleges.length})
            </a>

            {/* City Pills */}
            {citiesWithCollegesInState.map((city) => {
              const isSelected = focusedCity?.slug === city.slug;
              const countInCity = allStateColleges.filter((c) => c.data.city_slug === city.slug).length;
              return (
                <a
                  href={getPermalink(`/colleges-in/${city.slug}`)}
                  class={`inline-flex items-center gap-1.5 min-h-[44px] px-4 py-2 rounded-none border text-xs transition ${
                    isSelected
                      ? 'font-bold bg-[var(--aw-color-accent)] border-[var(--aw-color-accent)] text-[var(--aw-color-on-accent)] shadow-sm'
                      : 'font-medium bg-white text-[var(--aw-color-text-default)] border-[var(--aw-color-border)] hover:border-[var(--aw-color-primary)] hover:text-[var(--aw-color-primary)]'
                  }`}
                >
                  {city.name}
                  <span class="px-1.5 py-0.2 rounded-none border border-[var(--aw-color-border)] text-[10px] bg-[var(--tt-cream-soft)] text-[var(--tt-ink)]">
                    {countInCity}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- Colleges Listing -->
    {
      stateColleges.length > 0 ? (
        <div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-heading font-bold text-[var(--aw-color-text-heading)]">
              Institutions ({stateColleges.length})
            </h2>
            <a
              href={getPermalink('/colleges')}
              class="text-xs font-semibold text-[var(--aw-color-link)] hover:underline flex items-center gap-1"
            >
              &larr; View All Colleges in India
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {stateColleges.map((college) => (
              <CollegeCard college={{ ...college.data, id: college.id }} />
            ))}
          </div>
        </div>
      ) : (
        <div class="bg-[var(--aw-color-bg-soft)] border border-[var(--aw-color-border)] rounded-none p-10 text-center max-w-xl mx-auto my-8">
          <div class="w-12 h-12 rounded-none bg-white border border-[var(--aw-color-border)] flex items-center justify-center mx-auto mb-3 text-muted">
            <span class="text-xl font-bold font-heading text-[var(--aw-color-primary)]">T</span>
          </div>
          <h3 class="text-lg font-heading font-bold text-[var(--aw-color-text-heading)] mb-2">
            Cataloging Colleges in {stateName}
          </h3>
          <p class="text-xs text-[var(--aw-color-text-muted)] leading-relaxed mb-6">
            We are compiling colleges in {stateName}. Speak with a counsellor for admission options now.
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <Button variant="primary" text="Request Admission Info" href={getPermalink('/contact')} />
            <Button variant="outline" text="Browse All Colleges" href={getPermalink('/colleges')} />
          </div>
        </div>
      )
    }

    <!-- Bottom Guidance Strip -->
    <div
      class="mt-16 bg-white border border-[var(--aw-color-border)] rounded-none p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm"
    >
      <div class="max-w-2xl">
        <h3 class="text-xl sm:text-2xl font-heading font-bold text-[var(--aw-color-text-heading)] mb-2">
          Seeking Admission in {stateName}?
        </h3>
        <p class="text-xs sm:text-sm text-[var(--aw-color-text-muted)] leading-relaxed">
          Tawam Travels provides expert advisory on domicile eligibility, state quota counselling (such as TNEA, KEA, or
          JoSAA), management admissions, and scholarship procedures.
        </p>
      </div>
      <div class="shrink-0 flex gap-3">
        <Button variant="primary" text="Enquire Now" href={getPermalink('/contact')} />
        <Button variant="outline" text="Explore Courses" href={getPermalink('/courses')} />
      </div>
    </div>
  </section>
  <InquiryCtaBand />
</Layout>
