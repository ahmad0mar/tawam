---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import GuideGrid from '~/components/guides/GuideGrid.astro';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const entries = (await getCollection('exams')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const items = entries.map(({ id, data: d }) => ({
  title: d.name,
  summary: `${d.level} · ${d.conducting_body}`,
  href: getPermalink('/exams/' + id),
  image: d.image,
  imageAlt: d.imageAlt,
}));

const metadata = {
  title: 'Exams',
  description: 'Entrance exam guides covering eligibility, pattern, fees and the admission process.',
};
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow="Exam Gateway"
    title="Entrance Exams"
    subtitle="Entrance exam guides covering eligibility, pattern, fees and the admission process."
  />
  <section class="px-6 sm:px-6 py-12 sm:py-16 mx-auto max-w-6xl">
    <GuideGrid items={items} />
  </section>
</Layout>
