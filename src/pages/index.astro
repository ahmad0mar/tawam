---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import AboutBand from '~/components/widgets/AboutBand.astro';
import IndiaMap from '~/components/widgets/IndiaMap.astro';
import DisciplinesJourney from '~/components/widgets/DisciplinesJourney.astro';
import StudyDestinations from '~/components/widgets/StudyDestinations.astro';
import CounsellingSteps from '~/components/widgets/CounsellingSteps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import InquiryCtaBand from '~/components/widgets/InquiryCtaBand.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Image from '~/components/common/Image.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { getPermalink } from '~/utils/permalinks';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Tawam Travels — Education Counselling & College Admissions in India',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];

// Fetch popular courses
const courses = await getCollection('courses');
const popularCourses = courses.slice(0, 3).map((c) => ({
  ...c.data,
  slug: c.id.replace(/\.(md|mdx)$/, ''),
  url: getPermalink(`/courses/${c.id.replace(/\.(md|mdx)$/, '')}`),
}));

// Fetch entrance exams
const exams = await getCollection('exams');
const popularExams = exams.slice(0, 3).map((e) => ({
  ...e.data,
  slug: e.id.replace(/\.(md|mdx)$/, ''),
  url: getPermalink(`/exams/${e.id.replace(/\.(md|mdx)$/, '')}`),
}));
const heroCities = [
  {
    name: 'Delhi',
    tagline: 'History & Heritage',
    href: getPermalink('/colleges-in/delhi'),
    image: '~/assets/images/cities/delhi-india-gate.jpg',
  },
  {
    name: 'Bengaluru',
    tagline: 'Tech & Innovation',
    href: getPermalink('/colleges-in/karnataka'),
    image: '~/assets/images/cities/bengaluru-vidhana-soudha.jpg',
  },
  {
    name: 'Mumbai',
    tagline: 'Dream City',
    href: getPermalink('/colleges-in/maharashtra'),
    image: '~/assets/images/cities/mumbai-gateway-of-india.jpg',
  },
  {
    name: 'Chennai',
    tagline: 'Culture & Knowledge',
    href: getPermalink('/colleges-in/tamil-nadu'),
    image: '~/assets/images/cities/chennai-high-court.jpg',
  },
  {
    name: 'Kolkata',
    tagline: 'Arts & Education',
    href: getPermalink('/colleges-in/west-bengal'),
    image: '~/assets/images/cities/kolkata-dakshineswar.jpg',
  },
];
---

<Layout metadata={metadata} showPreloader>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. Hero Section ******************* -->
  <Hero
    animateHero
    variant="showcase"
    tagline="Education Counselling & Admissions"
    actions={[
      {
        variant: 'primary',
        text: 'Get Counselling &rarr;',
        href: getPermalink('/contact'),
      },
      {
        variant: 'glass',
        text: 'Browse Colleges',
        href: getPermalink('/colleges'),
      },
    ]}
  >
    <Fragment slot="bg">
      <div id="aw-hero-bg-layers" class="absolute inset-0 overflow-hidden bg-[var(--tt-teal-navy-deep)]">
        <div data-hero-bg="default" class="absolute inset-0 transition-opacity duration-500 ease-out opacity-100">
          <Image
            src="~/assets/images/random/taj-mahal-travel.jpeg"
            alt="Student overlooking Indian heritage architecture at sunset representing higher education journeys"
            layout="cover"
            class="aw-hero-bg-img w-full h-full object-cover object-center"
            widths={[640, 1024, 1600]}
            sizes="100vw"
            width={1600}
            height={960}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        {
          heroCities.map((city) => (
            <div data-hero-bg={city.name} class="absolute inset-0 transition-opacity duration-500 ease-out opacity-0">
              <Image
                src={city.image}
                alt={`${city.name} — ${city.tagline}`}
                layout="cover"
                class="w-full h-full object-cover object-center"
                widths={[640, 1024, 1600]}
                sizes="100vw"
                width={1600}
                height={960}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
        <div class="absolute inset-0 bg-gradient-to-b from-[#112542]/80 via-[#1B365D]/70 to-[#112542]/92"></div>
      </div>
    </Fragment>

    <Fragment slot="title">
      <div class="flex flex-col items-center justify-center gap-2">
        <span class="text-white drop-shadow-md uppercase tracking-wide flex flex-col items-center">
          <span class="aw-hero-line-mask">
            <span class="aw-hero-line text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[0.06em]" data-line="1">
              STUDY IN
            </span>
          </span>
          <span class="aw-hero-line-mask">
            <span
              class="aw-hero-line tt-gold-gradient-text text-5xl sm:text-7xl lg:text-[5.5rem] leading-[0.95] tracking-tight font-bold"
              data-line="2"
            >
              INDIA
            </span>
          </span>
        </span>
      </div>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-white/95 drop-shadow">
        Direct guidance for medical, engineering, and management admissions across India.
      </span>
    </Fragment>

    <Fragment slot="bottom">
      <div class="flex flex-col items-center gap-5 pt-4 pb-12 sm:pb-0 border-t border-white/20">
        <div
          id="aw-hero-city-strip"
          class="w-full grid grid-cols-2 sm:flex lg:grid lg:grid-cols-5 gap-2.5 sm:gap-4 sm:overflow-x-auto pb-1 lg:pb-0 aw-no-scrollbar"
        >
          {
            heroCities.map((city, idx) => (
              <a
                href={city.href}
                data-hero-city={city.name}
                class:list={[
                  'group sm:shrink-0 sm:w-44 lg:w-auto rounded-none overflow-hidden bg-[#112542]/85 backdrop-blur-md border border-white/25 hover:border-[var(--tt-gold)] shadow-lg transition-all duration-300 hover:-translate-y-1 flex flex-col',
                  idx === 4 ? 'col-span-2 sm:col-span-1' : '',
                ]}
              >
                <div class="relative aspect-[16/9] w-full overflow-hidden">
                  <Image
                    src={city.image}
                    alt={`${city.name} — ${city.tagline}`}
                    layout="cover"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    width={320}
                    height={200}
                    loading={idx < 2 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#112542]/85 via-transparent to-transparent" />
                </div>
                <div class="px-3 py-2 text-center">
                  <div class="font-heading font-bold text-white text-sm sm:text-base leading-tight group-hover:text-[var(--tt-gold-bright)] transition-colors">
                    {city.name}
                  </div>
                  <div class="text-[11px] text-white/80 mt-0.5">{city.tagline}</div>
                </div>
              </a>
            ))
          }
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={getPermalink('/contact')} class="btn-primary text-xs sm:text-sm py-2.5 px-6 whitespace-nowrap">
            Plan Your Study Journey &rarr;
          </a>
        </div>
      </div>
    </Fragment>
  </Hero>

  <!-- Interactive India Map ************* -->
  <IndiaMap
    tagline="Interactive Campus Discovery"
    title="Explore Colleges Across India by State"
    subtitle="Hover or tap any state to view NIRF colleges and seat info."
  />

  <!-- 2. About Tawam Travels ******* -->
  <AboutBand />

  <!-- 3. Top Study Destinations ************* -->
  <StudyDestinations />

  <!-- 5. Popular Disciplines & Courses ******************** -->
  <DisciplinesJourney />

  <!-- Popular Courses Grid -->
  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6">
    <div class="bg-[var(--aw-color-bg-soft)] rounded-none p-6 sm:p-8 border border-[var(--aw-color-border)]">
      <div class="text-center max-w-2xl mx-auto mb-7">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--aw-color-accent)]">Programmes</span>
        <h3 class="text-2xl sm:text-3xl font-bold text-[var(--aw-color-text-heading)] mt-1 mb-2">
          Explore Flagship Degrees
        </h3>
        <a href={getPermalink('/courses')} class="text-xs font-bold text-[var(--aw-color-link)] hover:underline">
          View All Courses &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          popularCourses.map((crs) => (
            <a
              href={crs.url}
              class="p-5 rounded-none bg-white border border-[var(--aw-color-border)] hover:border-[var(--aw-color-primary)] hover:shadow-md transition flex flex-col justify-between text-center"
            >
              <div>
                <span class="inline-block text-[10px] font-bold px-2.5 py-0.5 rounded-none bg-[var(--aw-color-bg-soft)] text-[#C93D25] border border-[var(--aw-color-border)] uppercase">
                  {crs.level} · {crs.duration}
                </span>
                <h4 class="text-base font-bold text-[var(--aw-color-text-heading)] mt-3 mb-1">{crs.name}</h4>
                <p class="text-xs text-[var(--aw-color-text-muted)] line-clamp-2 mb-3">
                  Eligibility: {crs.eligibility}
                </p>
              </div>
              <div class="pt-3 border-t border-[var(--aw-color-border)] flex items-center justify-center gap-2 text-xs font-semibold text-[var(--aw-color-link)]">
                <span>View Syllabus &amp; Top Colleges</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. National Entrance Exams ****************** -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-[#C93D25]">Exam Gateway</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--aw-color-text-heading)] mt-1 mb-2">Key Entrance Exams</h2>
      <p class="text-xs sm:text-sm text-[var(--aw-color-text-muted)]">
        Exam patterns, syllabus highlights, and past cutoff ranks.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        popularExams.map((ex) => (
          <div class="p-6 rounded-none bg-white border border-[var(--aw-color-border)] shadow-sm hover:shadow-md hover:border-[var(--aw-color-primary)] transition flex flex-col justify-between text-center">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-[#C93D25] uppercase">{ex.level}</span>
                <span class="text-[10px] px-2 py-0.5 rounded-none border border-[var(--aw-color-border)] bg-[var(--aw-color-bg-soft)] text-[var(--aw-color-text-muted)]">
                  {ex.conducting_body}
                </span>
              </div>
              <h3 class="text-lg font-bold text-[var(--aw-color-text-heading)] mb-2">
                <a href={ex.url} class="hover:text-[var(--aw-color-primary)] transition">
                  {ex.name}
                </a>
              </h3>
              <p class="text-xs text-[var(--aw-color-text-muted)] mb-4">Qualifying exam for top Indian institutions.</p>
            </div>
            <a
              href={ex.url}
              class="pt-3 border-t border-[var(--aw-color-border)] text-xs font-bold text-[var(--aw-color-link)] hover:underline flex items-center justify-center gap-2"
            >
              <span>Pattern &amp; Cutoffs</span>
              <span>&rarr;</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7. How Counselling Works (3 Steps) ************** -->
  <CounsellingSteps
    title="How Tawam Counselling Works"
    subtitle="Three simple steps to admission."
    items={[
      {
        title: 'Consultation & Assessment',
        description: 'Review scores, preferred states, and tuition budget.',
      },
      {
        title: 'College Shortlisting & Cutoffs',
        description: 'Compare colleges by closing ranks, NAAC grades, and fees.',
      },
      {
        title: 'Application & Counselling',
        description: 'End-to-end help with MCC, JoSAA, and CET rounds.',
      },
    ]}
  />

  <!-- 8. Student Stories & Testimonials *************** -->
  <section class="py-12 bg-[var(--aw-color-bg-soft)] border-y border-[var(--aw-color-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-[#C93D25]">Student Success</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[var(--aw-color-text-heading)] mt-1 mb-2">
          Trusted by Students &amp; Families
        </h2>
        <p class="text-xs sm:text-sm text-[var(--aw-color-text-muted)]">Verified admission stories across India.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div
          class="p-6 rounded-none bg-white border border-[var(--aw-color-border)] shadow-sm flex flex-col justify-between text-center"
        >
          <p class="text-xs sm:text-sm text-[var(--aw-color-text-default)] leading-relaxed mb-4">
            &ldquo;Tawam mapped out our exact NEET-UG Round 1 options between state quota and deemed universities before
            choice locking.&rdquo;
          </p>
          <div class="pt-3 border-t border-[var(--aw-color-border)]">
            <div class="text-xs font-bold text-[var(--aw-color-text-heading)]">Pooja R.</div>
            <div class="text-[11px] font-semibold text-[#C93D25]">Admitted: MBBS, CMC Vellore</div>
          </div>
        </div>

        <div
          class="p-6 rounded-none bg-white border border-[var(--aw-color-border)] shadow-sm flex flex-col justify-between text-center"
        >
          <p class="text-xs sm:text-sm text-[var(--aw-color-text-default)] leading-relaxed mb-4">
            &ldquo;They compared VIT Category 2 and COMEDK fees upfront with zero sales push.&rdquo;
          </p>
          <div class="pt-3 border-t border-[var(--aw-color-border)]">
            <div class="text-xs font-bold text-[var(--aw-color-text-heading)]">Aditya S.</div>
            <div class="text-[11px] font-semibold text-[#C93D25]">Admitted: B.Tech CSE, VIT Vellore</div>
          </div>
        </div>

        <div
          class="p-6 rounded-none bg-white border border-[var(--aw-color-border)] shadow-sm flex flex-col justify-between text-center"
        >
          <p class="text-xs sm:text-sm text-[var(--aw-color-text-default)] leading-relaxed mb-4">
            &ldquo;Their closing-rank check helped us secure NIT Trichy in Round 5 with every JoSAA document
            ready.&rdquo;
          </p>
          <div class="pt-3 border-t border-[var(--aw-color-border)]">
            <div class="text-xs font-bold text-[var(--aw-color-text-heading)]">Karthik M.</div>
            <div class="text-[11px] font-semibold text-[#C93D25]">Admitted: B.Tech, NIT Trichy</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog / Guides ****************** -->
  <BlogLatestPosts
    title="Latest Admission Guides & Insights"
    information="Guides on NEET counselling, scholarships, and college comparisons."
    linkText="View All Articles"
    linkUrl={getPermalink('/blog')}
    count={3}
  />

  <!-- 9. Counselling CTA Inquiry Band ********************** -->
  <InquiryCtaBand />

  <script>
    const initHeroCityPreview = () => {
      const strip = document.getElementById('aw-hero-city-strip');
      const bgContainer = document.getElementById('aw-hero-bg-layers');
      if (!strip || !bgContainer || strip.dataset.previewBound === 'true') return;
      strip.dataset.previewBound = 'true';

      const layers = Array.from(bgContainer.querySelectorAll<HTMLElement>('[data-hero-bg]'));
      const cards = Array.from(strip.querySelectorAll<HTMLElement>('[data-hero-city]'));
      if (!layers.length || !cards.length) return;

      const showLayer = (targetKey: string) => {
        layers.forEach((layer) => {
          const isMatch = layer.dataset.heroBg === targetKey;
          layer.classList.toggle('opacity-100', isMatch);
          layer.classList.toggle('opacity-0', !isMatch);
        });
      };

      cards.forEach((card) => {
        const city = card.dataset.heroCity;
        if (!city) return;
        card.addEventListener('mouseenter', () => showLayer(city));
        card.addEventListener('focus', () => showLayer(city));
      });

      strip.addEventListener('mouseleave', () => showLayer('default'));
      strip.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (!next || !strip.contains(next)) {
          showLayer('default');
        }
      });
    };

    initHeroCityPreview();
    document.addEventListener('astro:page-load', initHeroCityPreview);
  </script>
</Layout>
