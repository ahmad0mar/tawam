---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { CallToAction } from '~/types';

export interface Props extends CallToAction {
  arrow?: boolean;
}

const {
  variant = 'secondary',
  target,
  text = Astro.slots.render('default'),
  icon = '',
  arrow = false,
  class: className = '',
  type,
  ...rest
} = Astro.props;

const variants = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
  'outline-white': 'btn-outline-white',
  glass: 'btn-glass',
  tertiary: 'btn-tertiary',
  link: 'cursor-pointer hover:text-primary',
};
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={twMerge(variants[variant] || '', className)} {...rest}>
      <Fragment set:html={text} />
      {arrow && (
        <span
          class="ml-1.5 inline-block transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          &rarr;
        </span>
      )}
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </button>
  ) : (
    <a
      class={twMerge(variants[variant] || '', className)}
      {...(target ? { target: target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      {arrow && (
        <span
          class="ml-1.5 inline-block transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          &rarr;
        </span>
      )}
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </a>
  )
}
