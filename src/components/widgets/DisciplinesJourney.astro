---
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

const disciplines = [
  {
    title: 'Medical Admissions (MBBS / BDS)',
    description: 'NEET-UG AIQ and state quota counselling guidance.',
    image: '~/assets/images/courses/mbbs/cover.jpeg',
    href: getPermalink('/courses/mbbs'),
  },
  {
    title: 'Engineering & Technology (B.Tech)',
    description: 'JEE Main and state CET college shortlisting.',
    image: '~/assets/images/courses/btech-computer-science/cover.jpeg',
    href: getPermalink('/courses/btech-computer-science'),
  },
  {
    title: 'Management & Commerce (MBA / BBA)',
    description: 'Accredited B-school admissions, fees, and placements.',
    image: '~/assets/images/courses/bba/cover.jpeg',
    href: getPermalink('/courses/bba'),
  },
  {
    title: 'Allied Sciences & Law',
    description: 'Nursing, pharmacy, allied health, and integrated law.',
    image: '~/assets/images/exams/cuet-ug/cover.jpeg',
    href: getPermalink('/courses'),
  },
];
---

<Section id="disciplines" tone="navy" mandala="left" class="py-16 sm:py-24">
  <!-- Desktop-only faint vertical text on far right -->
  <div
    aria-hidden="true"
    class="hidden xl:flex items-center justify-center pointer-events-none select-none absolute right-5 top-1/2 -translate-y-1/2 text-[11px] font-semibold tracking-[0.4em] uppercase text-white/20 [writing-mode:vertical-rl]"
  >
    MORE THAN JUST STUDIES
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start xl:pr-8">
    <!-- Left column -->
    <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-6 lg:sticky lg:top-28">
      <div>
        <SectionHeader
          tone="dark"
          eyebrow="Academic Streams"
          title="Admission Counselling by Stream"
          subtitle="Verified eligibility, entrance exams, and college options."
        />

        <div class="mt-7">
          <a href={getPermalink('/courses')} class="btn-primary text-sm py-3 px-7"> Explore &rarr; </a>
        </div>
      </div>

      <p
        class="font-heading font-semibold text-xl sm:text-2xl text-[var(--tt-gold-bright)]/95 pt-4 lg:pt-10 leading-snug"
      >
        Study in India,<br />Build a Better Future
      </p>
    </div>

    <!-- Right column: vertical timeline with square markers & thumbnails -->
    <div class="lg:col-span-7 relative pl-6 sm:pl-8">
      <!-- Vertical connecting line -->
      <div
        aria-hidden="true"
        class="absolute left-[7px] sm:left-[9px] top-3 bottom-3 w-px bg-gradient-to-b from-[var(--tt-gold)]/70 via-white/25 to-transparent"
      >
      </div>

      <div class="space-y-5">
        {
          disciplines.map((item) => (
            <a
              href={item.href}
              class="group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-none bg-white/[0.06] hover:bg-white/[0.1] border border-white/20 hover:border-[var(--tt-gold)] p-4 sm:p-5 transition-all duration-300 hover:-translate-y-0.5 intersect-once js:motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
            >
              {/* Timeline square marker */}
              <span
                aria-hidden="true"
                class="absolute -left-[23px] sm:-left-[29px] top-6 sm:top-1/2 sm:-translate-y-1/2 w-3 h-3 rounded-none bg-[var(--tt-gold)] ring-4 ring-[var(--tt-teal-navy)] group-hover:scale-125 transition-transform duration-200"
              />

              <div class="flex-1 min-w-0">
                <h3 class="font-heading font-bold text-lg text-white group-hover:text-[var(--tt-gold-bright)] transition-colors">
                  {item.title}
                </h3>
                <p class="text-sm sm:text-base text-white/80 mt-1 leading-relaxed">{item.description}</p>
              </div>

              <div class="shrink-0 w-full sm:w-40 aspect-[16/10] rounded-none overflow-hidden border border-white/25 bg-[var(--tt-teal-navy-deep)]">
                <Image
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
                  width={320}
                  height={200}
                  loading="lazy"
                />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Section>
