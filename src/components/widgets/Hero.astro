---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import { twMerge } from 'tailwind-merge';

import type { Hero as HeroProps } from '~/types';

export interface Props extends Omit<HeroProps, 'id'> {
  id?: string;
  animateHero?: boolean;
  variant?: 'default' | 'showcase';
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  animateHero = false,
  variant = 'default',
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const isShowcase = variant === 'showcase';

// `image.aspect: 'auto'` shows the picture whole (transparent illustrations);
// the default crops it to the hero frame.
const { aspect: imageAspect, ...imageProps } = typeof image === 'object' && image ? image : { src: '', alt: '' };
const imageWhole = imageAspect === 'auto';
---

<section
  class:list={[
    'relative not-prose overflow-hidden',
    isShowcase
      ? '-mt-[64px] lg:-mt-[76px] min-h-[82svh] lg:min-h-[100svh] flex flex-col justify-between'
      : 'md:-mt-[76px]',
    { 'aw-hero': animateHero },
  ]}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div
    class:list={[
      'relative max-w-7xl mx-auto px-5 sm:px-6 w-full',
      isShowcase ? 'flex-1 flex flex-col justify-between pt-20 sm:pt-28 pb-6 sm:pb-10' : '',
    ]}
  >
    {!isShowcase && <div class="pt-0 md:pt-[76px] pointer-events-none" />}
    <div class:list={[isShowcase ? 'my-auto py-4 sm:py-8' : 'py-12 md:py-20']}>
      <div class="text-center max-w-3xl mx-auto pb-8 md:pb-10">
        {
          badge && (
            <span class="inline-block mb-4 rounded-none border border-primary/40 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
              {badge}
            </span>
          )
        }
        {
          tagline && (
            <p
              class:list={[
                isShowcase
                  ? 'tt-eyebrow text-[var(--tt-gold-bright)] mb-4 justify-center'
                  : 'text-base text-secondary font-bold tracking-wide uppercase',
              ]}
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={[
                'font-bold leading-[1.08] tracking-tight mb-5 font-heading',
                isShowcase
                  ? 'text-[clamp(2rem,4.5vw,3.75rem)] text-white'
                  : 'text-[clamp(2rem,4.5vw,3.5rem)] text-heading',
              ]}
              set:html={title}
            />
          )
        }
        <div class="max-w-2xl mx-auto">
          {
            subtitle && (
              <p
                class:list={[
                  isShowcase ? 'text-base sm:text-lg text-white/90 mb-7 leading-relaxed' : 'text-xl text-muted mb-6',
                  { 'aw-hero-sub': animateHero },
                ]}
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div
                class:list={[
                  'flex flex-wrap gap-3.5 justify-center',
                  !isShowcase && 'max-w-xs sm:max-w-md m-auto flex-col sm:flex-row sm:justify-center',
                  { 'aw-hero-actions': animateHero },
                ]}
              >
                {Array.isArray(actions) ? (
                  actions.map((action) => {
                    const { class: actionClass = '', ...actionRest } =
                      typeof action === 'object' && action ? action : {};
                    return (
                      <div class="flex w-full sm:w-auto">
                        <Button {...actionRest} class={twMerge('w-full sm:mb-0', actionClass)} />
                      </div>
                    );
                  })
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div>
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class:list={[
                    'mx-auto',
                    imageWhole ? 'w-auto max-h-[32rem] object-contain md:max-h-[44rem]' : 'rounded-none w-full',
                  ]}
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  {...(imageWhole ? { inferSize: true, layout: 'none' } : { width: 1024, height: 576 })}
                  format="webp"
                  {...imageProps}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
    {
      Astro.slots.has('bottom') && (
        <div class="relative pt-4">
          <slot name="bottom" />
        </div>
      )
    }
  </div>
</section>

<style is:global>
  @media (width >= 768px) {
    html.js .aw-hero .aw-hero-line-mask {
      display: block;
      overflow: hidden;
    }

    html.js .aw-hero .aw-hero-line {
      display: block;
      opacity: 0;
      transform: translateY(105%);
      will-change: transform, opacity;
    }

    html.js .aw-hero .aw-hero-sub,
    html.js .aw-hero .aw-hero-actions {
      opacity: 0;
      transform: translateY(var(--aw-reveal-distance, 12px));
      will-change: transform, opacity;
    }

    html.js .aw-hero .aw-hero-bg-img {
      transform: scale(1.06);
      will-change: transform;
    }

    html.js .aw-hero.is-ready .aw-hero-line {
      animation: awHeroLineIn 560ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) forwards;
    }

    html.js .aw-hero.is-ready .aw-hero-line[data-line='2'] {
      animation-delay: 80ms;
    }

    html.js .aw-hero.is-ready .aw-hero-sub {
      animation: awHeroFadeUp 500ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) 180ms forwards;
    }

    html.js .aw-hero.is-ready .aw-hero-actions {
      animation: awHeroFadeUp 500ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) 260ms forwards;
    }

    html.js .aw-hero.is-ready .aw-hero-bg-img {
      animation: awHeroBgSettle var(--aw-motion-hero, 900ms) var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) forwards;
    }
  }

  @media (width < 768px) {
    html.js .aw-hero .aw-hero-line-mask,
    html.js .aw-hero .aw-hero-line {
      display: block;
    }
  }

  @keyframes awHeroLineIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes awHeroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes awHeroBgSettle {
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .aw-hero .aw-hero-line,
    html.js .aw-hero .aw-hero-sub,
    html.js .aw-hero .aw-hero-actions,
    html.js .aw-hero .aw-hero-bg-img {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const startHeroSequence = () => {
    const hero = document.querySelector<HTMLElement>('.aw-hero');
    if (!hero || hero.classList.contains('is-ready')) return;

    const preloader = document.getElementById('aw-preloader');
    const preloaderActive =
      preloader &&
      !document.documentElement.classList.contains('aw-preloader-skip') &&
      !preloader.classList.contains('is-leaving') &&
      !preloader.classList.contains('is-done');

    const play = () => hero.classList.add('is-ready');

    if (preloaderActive) {
      document.addEventListener('aw:preloader-done', play, { once: true });
      window.setTimeout(play, 2600);
    } else {
      window.requestAnimationFrame(play);
    }
  };

  startHeroSequence();
  document.addEventListener('astro:page-load', startHeroSequence);
</script>
