---
import Image from '~/components/common/Image.astro';
import Section from '~/components/ui/Section.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, image, imageAlt = '', align = 'left' } = Astro.props;
---

<Section tone="navy" mandala="right" class="-mt-[76px] pt-28 sm:pt-32 pb-12 sm:pb-16">
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-gradient-to-br from-[#071D28] via-[#0B2A3A] to-[#123E54]" aria-hidden="true">
      {
        image && (
          <Image
            src={image}
            alt={imageAlt}
            class="w-full h-full object-cover object-center opacity-25"
            width={1600}
            height={520}
            loading="eager"
            decoding="async"
          />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-[#071D28]/90 via-[#0B2A3A]/70 to-[#071D28]/80"></div>
    </div>
  </Fragment>

  <div class:list={[align === 'center' ? 'text-center mx-auto max-w-3xl' : 'max-w-3xl']}>
    {
      eyebrow && (
        <div
          class:list={[
            'tt-eyebrow text-[var(--tt-gold-bright)] mb-3',
            align === 'center' ? 'justify-center' : 'justify-start',
          ]}
        >
          <span>{eyebrow}</span>
        </div>
      )
    }
    <h1 class="text-3xl sm:text-5xl font-heading font-bold text-white tracking-tight leading-tight">
      <Fragment set:html={title} />
    </h1>
    {
      subtitle && (
        <p class="mt-3 text-sm sm:text-base text-white/80 leading-relaxed">
          <Fragment set:html={subtitle} />
        </p>
      )
    }
  </div>
</Section>
