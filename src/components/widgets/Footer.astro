---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import logoImg from '~/assets/images/brand/tawam-travels-logo.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="relative bg-[var(--tt-teal-navy-deep)] text-[#E8EEF9] not-prose border-t border-white/10">
  <div class="relative max-w-7xl mx-auto px-5 sm:px-6 pt-12 pb-24 md:py-14">
    <div class="grid grid-cols-12 gap-8 pb-8">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-4">
          <a class="inline-block bg-white rounded-none p-3 shadow-sm border border-white/25" href={getHomePermalink()}>
            <img
              src={logoImg.src}
              alt={SITE?.name || 'Tawam Travels'}
              class="h-11 sm:h-12 w-auto object-contain block"
              loading="lazy"
              decoding="async"
              style="object-fit: contain !important;"
            />
          </a>
        </div>
        <p class="text-[#C6D2E6] text-sm leading-relaxed mb-4 max-w-md">
          Education counselling, entrance guidance, and admission support across India.
        </p>
        <div class="text-xs text-[#C6D2E6] flex flex-wrap gap-2">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-[#C6D2E6] hover:text-[var(--tt-gold-bright)] transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links: columnLinks }) => (
          <div class="col-span-6 md:col-span-4 lg:col-span-2">
            <div class="text-white font-semibold mb-3 tracking-wide text-sm">{title}</div>
            {columnLinks && Array.isArray(columnLinks) && columnLinks.length > 0 && (
              <ul class="text-sm space-y-1">
                {columnLinks.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-[#C6D2E6] hover:text-[var(--tt-gold-bright)] transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      <div class="col-span-12 lg:col-span-2 flex flex-col lg:items-end justify-between gap-4">
        <p class="font-heading font-bold text-lg text-[var(--tt-gold-bright)] lg:text-right leading-snug">
          Dream Big<br />Study in India
        </p>
        {
          socialLinks?.length ? (
            <ul class="flex items-center gap-2.5">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="inline-flex items-center justify-center w-11 h-11 rounded-none bg-white/[0.08] border border-white/25 text-[#E8EEF9] hover:text-white hover:bg-[var(--tt-gold)] hover:border-[var(--tt-gold)] transition-colors"
                    aria-label={ariaLabel}
                    href={href}
                    target={href?.startsWith('http') ? '_blank' : undefined}
                    rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {icon && <Icon name={icon} class="w-4 h-4" />}
                    {text && <Fragment set:html={text} />}
                  </a>
                </li>
              ))}
            </ul>
          ) : null
        }
      </div>
    </div>
    <div
      class="border-t border-white/10 pt-6 mt-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-[#A3B3D1]"
    >
      <div>
        <Fragment set:html={footNote} />
      </div>
      <div class="text-white/60">Education Counselling &amp; Admissions Across India</div>
    </div>
  </div>
</footer>
