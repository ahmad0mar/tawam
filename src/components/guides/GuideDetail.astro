---
import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  title: string;
  kicker: string;
  facts: Array<{ label: string; value?: string | string[] }>;
  image?: string;
  imageAlt?: string;
  updated?: Date;
}

const { title, kicker, facts, image, imageAlt, updated } = Astro.props;
const img = await findImage(image);
const visibleFacts = facts.filter((f) => f.value && (!Array.isArray(f.value) || f.value.length));
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header>
      <p
        class="max-w-3xl mx-auto px-4 sm:px-6 mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--aw-color-accent)]"
      >
        {kicker}
        {
          updated && (
            <span class="normal-case font-normal text-muted">
              {' '}
              · Updated <time datetime={updated.toISOString()}>{getFormattedDate(updated)}</time>
            </span>
          )
        }
      </p>
      <h1
        class="px-5 sm:px-6 max-w-3xl mx-auto text-[clamp(2rem,4vw,3rem)] font-bold leading-tighter tracking-tighter font-heading text-[var(--aw-color-text-heading)]"
      >
        {title}
      </h1>
      {
        img && (
          <Image
            src={img}
            class="max-w-full lg:max-w-[900px] mx-auto mt-8 mb-6 rounded-none border border-[var(--tt-border-warm)] bg-[var(--tt-cream-soft)]"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        )
      }
    </header>

    {
      visibleFacts.length > 0 && (
        <aside class="mx-auto px-4 sm:px-6 max-w-3xl mt-8">
          <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 rounded-none border border-[var(--tt-border-warm)] p-5 bg-white shadow-[var(--tt-shadow-soft)]">
            {visibleFacts.map((fact) => (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--tt-gold-dark)]">{fact.label}</dt>
                <dd class="mt-1 text-[var(--tt-ink)]">
                  {Array.isArray(fact.value) ? (
                    <ul class="list-disc pl-5">
                      {fact.value.map((v) => (
                        <li>{v}</li>
                      ))}
                    </ul>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      )
    }

    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose lg:prose-xl prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:text-[var(--tt-ink)] prose-a:text-[var(--aw-color-link)] prose-img:rounded-none prose-img:shadow-md mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0 prose-p:text-[var(--aw-color-text-default)] prose-li:text-[var(--aw-color-text-default)] prose-p:leading-relaxed"
    >
      <slot />
    </div>
  </article>
</section>
