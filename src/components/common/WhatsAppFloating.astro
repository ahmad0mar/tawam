---
import { Icon } from 'astro-icon/components';
import { SITE_INFO } from '~/data/site';

const rawValue = String(SITE_INFO.contact.whatsapp || '');
const hasRealPhone = rawValue !== '' && rawValue !== 'TODO';
const phoneDigits = hasRealPhone ? rawValue.replace(/[^0-9]/g, '') : '';

const defaultMessage = encodeURIComponent('Hello Tawam Travels, I am seeking college admission guidance.');
const whatsappUrl = phoneDigits
  ? `https://wa.me/${phoneDigits}?text=${defaultMessage}`
  : `https://wa.me/?text=${defaultMessage}`;
---

<aside
  id="aw-whatsapp-floating"
  transition:persist="aw-whatsapp-floating"
  class="fixed right-4 sm:right-6 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-40 flex items-center group print:hidden pointer-events-auto transition-opacity duration-200"
  aria-label="Direct WhatsApp Admission Support"
>
  <a
    id="aw-whatsapp-btn"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center w-14 h-14 sm:w-auto sm:h-auto gap-2.5 bg-[#25D366] hover:bg-[#20ba59] text-white p-3.5 sm:px-4 sm:py-3 rounded-full shadow-xl shadow-emerald-950/25 transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-hidden focus:ring-4 focus:ring-emerald-400/50"
    title="Chat with an Academic Counsellor on WhatsApp"
  >
    <Icon name="tabler:brand-whatsapp" class="w-6 h-6 shrink-0" />
    <span class="text-sm font-semibold tracking-wide pr-1 hidden sm:inline-block"> Chat with Counsellor </span>
  </a>
</aside>

<style>
  @keyframes aw-whatsapp-pulse {
    0% {
      transform: scale(1);
      box-shadow:
        0 10px 25px -5px rgb(6 78 59 / 0.25),
        0 0 0 0 rgb(37 211 102 / 0.55);
    }
    55% {
      transform: scale(1.06);
      box-shadow:
        0 14px 28px -5px rgb(6 78 59 / 0.3),
        0 0 0 14px rgb(37 211 102 / 0);
    }
    100% {
      transform: scale(1);
      box-shadow:
        0 10px 25px -5px rgb(6 78 59 / 0.25),
        0 0 0 0 rgb(37 211 102 / 0);
    }
  }

  #aw-whatsapp-btn.aw-whatsapp-pulse {
    animation: aw-whatsapp-pulse 1.1s var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #aw-whatsapp-btn.aw-whatsapp-pulse {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__awWhatsappPulseScheduled) return;
    window.__awWhatsappPulseScheduled = true;
    try {
      if (sessionStorage.getItem('aw_wa_pulsed') === '1') return;
    } catch {
      // ignore storage errors
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    setTimeout(() => {
      const btn = document.getElementById('aw-whatsapp-btn');
      if (!btn) return;
      try {
        sessionStorage.setItem('aw_wa_pulsed', '1');
      } catch {
        // ignore
      }
      btn.classList.add('aw-whatsapp-pulse');
      btn.addEventListener(
        'animationend',
        () => {
          btn.classList.remove('aw-whatsapp-pulse');
        },
        { once: true }
      );
    }, 8000);
  })();
</script>
