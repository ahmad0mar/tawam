---
// Page-to-page navy curtain transition for Astro ClientRouter.
// Persists across swaps and sits at z-30 (below the z-40 header and WhatsApp button)
// so only the main content area is covered during navigation.
---

<aw-page-curtain transition:persist="aw-page-curtain">
  <div id="aw-page-curtain" class="aw-curtain" aria-hidden="true">
    <div class="aw-curtain-edge"></div>
    <div class="aw-curtain-progress"></div>
  </div>
</aw-page-curtain>

<style>
  aw-page-curtain {
    display: contents;
  }

  .aw-curtain {
    position: fixed;
    inset: 0;
    z-index: 30;
    background-color: var(--aw-color-primary, #011b4a);
    transform: translateY(100%);
    opacity: 1;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .aw-curtain-edge {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--aw-color-accent, #d08701);
  }

  .aw-curtain-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent 0%, #ecad04 50%, transparent 100%);
    opacity: 0;
    transform: translateX(-100%);
  }

  .aw-curtain.is-covering {
    pointer-events: auto;
    transform: translateY(0);
    transition: transform 220ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aw-curtain.is-waiting .aw-curtain-progress {
    opacity: 1;
    animation: awCurtainShimmer 1.1s ease-in-out infinite;
  }

  .aw-curtain.is-revealing {
    pointer-events: none;
    transform: translateY(-100%);
    transition: transform 280ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  /* Shorter, subtle fade for browser back/forward navigation */
  .aw-curtain.is-traverse {
    transform: translateY(0);
    opacity: 0;
    transition: opacity 150ms var(--aw-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .aw-curtain.is-traverse.is-covering {
    opacity: 1;
  }

  .aw-curtain.is-traverse.is-revealing {
    opacity: 0;
    transform: translateY(0);
  }

  @keyframes awCurtainShimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aw-curtain {
      display: none !important;
    }
  }
</style>

<script>
  interface BeforePreparationEvent extends Event {
    from: URL;
    to: URL;
    navigationType: 'push' | 'replace' | 'traverse';
    signal: AbortSignal;
    loader: () => Promise<void>;
  }

  class AwPageCurtain extends HTMLElement {
    private initialized = false;
    private safetyTimer: number | undefined;
    private resetTimer: number | undefined;
    private reducedMotion = () =>
      typeof window !== 'undefined' &&
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    private getPanel(): HTMLElement | null {
      return this.querySelector<HTMLElement>('#aw-page-curtain');
    }

    private clearTimers() {
      if (this.safetyTimer) {
        window.clearTimeout(this.safetyTimer);
        this.safetyTimer = undefined;
      }
      if (this.resetTimer) {
        window.clearTimeout(this.resetTimer);
        this.resetTimer = undefined;
      }
    }

    private resetToIdle(panel: HTMLElement) {
      panel.style.transition = 'none';
      panel.classList.remove('is-covering', 'is-waiting', 'is-revealing', 'is-traverse');
      // Force reflow so the instant reset to translateY(100%) doesn't animate
      void panel.offsetHeight;
      panel.style.transition = '';
    }

    private cover(isTraverse: boolean) {
      const panel = this.getPanel();
      if (!panel) return;
      this.clearTimers();
      this.resetToIdle(panel);
      if (isTraverse) {
        panel.classList.add('is-traverse');
        void panel.offsetHeight;
      }
      panel.classList.add('is-covering');

      // Hard cap: never leave the user behind the curtain for more than 3s
      this.safetyTimer = window.setTimeout(() => {
        this.reveal();
      }, 3000);
    }

    private reveal() {
      const panel = this.getPanel();
      if (!panel) return;
      if (!panel.classList.contains('is-covering')) return;

      this.clearTimers();
      const isTraverse = panel.classList.contains('is-traverse');
      panel.classList.remove('is-covering', 'is-waiting');
      panel.classList.add('is-revealing');

      this.resetTimer = window.setTimeout(
        () => {
          this.resetToIdle(panel);
        },
        isTraverse ? 170 : 300
      );
    }

    private onBeforePreparation = (ev: Event) => {
      const event = ev as BeforePreparationEvent;
      if (this.reducedMotion()) return;

      // Skip same-page / hash navigations
      if (event.from.pathname === event.to.pathname && event.from.search === event.to.search) {
        return;
      }

      const isTraverse = event.navigationType === 'traverse';
      const coverMs = isTraverse ? 140 : 220;
      const waitMs = isTraverse ? 180 : 260;

      this.cover(isTraverse);

      const originalLoader = event.loader;
      event.loader = async () => {
        const minCover = new Promise<void>((resolve) => window.setTimeout(resolve, coverMs));
        const waitTimer = window.setTimeout(() => {
          const panel = this.getPanel();
          if (panel && panel.classList.contains('is-covering')) {
            panel.classList.add('is-waiting');
          }
        }, waitMs);

        const onAbort = () => {
          window.clearTimeout(waitTimer);
          this.reveal();
        };
        event.signal?.addEventListener('abort', onAbort, { once: true });

        try {
          await Promise.all([originalLoader(), minCover]);
        } finally {
          window.clearTimeout(waitTimer);
          event.signal?.removeEventListener('abort', onAbort);
        }
      };
    };

    private onPageLoad = () => {
      this.reveal();
    };

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      document.addEventListener('astro:before-preparation', this.onBeforePreparation);
      document.addEventListener('astro:page-load', this.onPageLoad);
    }

    disconnectedCallback() {
      this.clearTimers();
      document.removeEventListener('astro:before-preparation', this.onBeforePreparation);
      document.removeEventListener('astro:page-load', this.onPageLoad);
      this.initialized = false;
    }
  }

  if (!customElements.get('aw-page-curtain')) {
    customElements.define('aw-page-curtain', AwPageCurtain);
  }
</script>
