---
export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class:
    className = 'flex flex-col h-11 w-11 rounded-none border border-white/25 bg-[#112542]/50 text-white justify-center items-center cursor-pointer group transition-colors',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} aria-expanded="false" data-aw-toggle-menu>
  <span class="sr-only">{label}</span>
  <slot>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-[3px] rounded-none bg-current transition ease transform duration-200 group-[.expanded]:rotate-45 group-[.expanded]:translate-y-[8px]"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-[3px] rounded-none bg-current transition ease transform duration-200 group-[.expanded]:opacity-0"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-[3px] rounded-none bg-current transition ease transform duration-200 group-[.expanded]:-rotate-45 group-[.expanded]:-translate-y-[8px]"
    ></span>
  </slot>
</button>
