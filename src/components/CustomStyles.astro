---
// Font families are provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro):
// Normal clean sans-serif (Inter) across headings, UI, and body.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    --aw-font-heading: var(--font-inter), ui-sans-serif, system-ui, sans-serif;

    /* IDP India inspired palette (Orange #F05F46, Blue #28558C, Green #1C827D, Charcoal #333333, White #FFFFFF) */
    --tt-cream: #ffffff;
    --tt-cream-soft: #f4f6fa;
    --tt-teal-navy: #1b365d;
    --tt-teal-navy-deep: #112542;
    --tt-gold: #f05f46;
    --tt-gold-bright: #ff7a59;
    --tt-gold-dark: #c93d25;
    --tt-idp-green: #1c827d;
    --tt-idp-blue: #28558c;
    --tt-ink: #222b38;
    --tt-ink-muted: #5a6577;
    --tt-border-warm: #d5dce6;
    --tt-radius-card: 0px;
    --tt-shadow-soft: 0 4px 16px rgb(27 54 93 / 7%);
    --tt-shadow-glass: 0 12px 28px rgb(17 37 66 / 26%);

    /* Mapped AstroWind tokens so inner pages & widgets stay consistent */
    --aw-color-primary: #28558c;
    --aw-color-secondary: #1b365d;
    --aw-color-accent: #f05f46;
    --aw-color-accent-hover: #d94a32;
    --aw-color-accent-text: #c93d25;
    --aw-color-link: #28558c;

    --aw-color-text-heading: #222b38;
    --aw-color-text-default: #333333;
    --aw-color-text-muted: #666666;
    --aw-color-bg-page: #ffffff;
    --aw-color-bg-soft: #f4f6fa;
    --aw-color-bg-warm: #fff5f2;
    --aw-color-border: #d5dce6;
    --aw-color-on-primary: #ffffff;
    --aw-color-on-accent: #ffffff;
    --aw-color-success: #1c827d;
    --aw-color-error: #c93d25;

    ::selection {
      background-color: #fde4df;
      color: #222b38;
    }
  }
</style>
