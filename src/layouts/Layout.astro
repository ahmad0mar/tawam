---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';
import Preloader from '~/components/common/Preloader.astro';
import PageCurtain from '~/components/common/PageCurtain.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  showPreloader?: boolean;
}

const { metadata = {}, showPreloader = false } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <!-- `js` flag: lets reveal-on-scroll items start hidden only when scripts are running.
         The router replaces <html> attributes on every page swap, so it is re-applied then. -->
    <script is:inline>
      (function () {
        const applyRootFlags = () => {
          const root = document.documentElement;
          root.classList.add('js');
          let skipPreloader = false;
          try {
            if (sessionStorage.getItem('aw_visited')) skipPreloader = true;
          } catch {
            // Storage may be blocked; fall back to media query check only.
          }
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            skipPreloader = true;
          }
          if (skipPreloader) root.classList.add('aw-preloader-skip');
        };
        applyRootFlags();
        document.addEventListener('astro:after-swap', applyRootFlags);
      })();
    </script>
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-playfair-display" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    {showPreloader && <Preloader />}
    <PageCurtain />
    <slot />

    <Intersect />
  </body>
</html>
